{
    "name": "@portfolio/core",
    "description": "Shared configuration and service discovery for the portfolio project",
    "version": "1.0.0",
    "private": true,
    "license": "ISC",
    "author": "Maxim Bezhenar",
    "type": "module",
    "exports": {
        ".": {
            "development": {
                "types": "./src/index.ts",
                "default": "./src/index.ts"
            },
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "test": "vitest run --config ../../vitest.config.ts packages/core/"
    },
    "devDependencies": {
        "@types/node": "26.6.6"
    }
}
