{
    "name": "portfolio",
    "description": "My personal playground as portfolio",
    "version": "1.0.0",
    "private": true,
    "license": "ISC",
    "author": "Maxim Bezhenar",
    "type": "module",
    "keywords": [
        "portfolio"
    ],
    "bugs": {
        "url": "https://github.com/Bezenar/portfolio/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Bezenar/portfolio.git"
    },
    "workspaces": [
        "packages/*",
        "mfe/*",
        "shell-ui",
        "server"
    ],
    "scripts": {
        "dev": "tsx --conditions=development scripts/start-dev.ts",
        "build": "tsx --conditions=development scripts/build-prod.ts",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage.enabled --coverage.reportsDirectory=coverage/all",
        "start": "NODE_ENV=production node server/dist/server.js",
        "docker:dev": "docker compose -p portfolio-dev -f docker/compose.yaml up --build --watch",
        "docker:dev-down": "docker compose -p portfolio-dev -f docker/compose.yaml down",
        "docker:prod": "docker compose -p portfolio-prod -f docker/compose.prod.yaml up --build",
        "docker:prod-down": "docker compose -p portfolio-prod -f docker/compose.prod.yaml down"
    },
    "devDependencies": {
        "@portfolio/core": "1.0.0",
        "@stylistic/eslint-plugin": "6.0.1",
        "@types/node": "26.6.6",
        "@vitest/coverage-v8": "5.1.1",
        "jsdom": "29.1.1",
        "oxfmt": "0.80.0",
        "oxlint": "1.90.0",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vitest": "5.1.1"
    }
}
